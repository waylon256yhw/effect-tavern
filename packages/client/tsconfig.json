{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/*.ts", "src/*.tsx", "src/*.d.ts", "test/*.ts", "vite.config.ts"]
}
