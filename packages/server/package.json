{
  "name": "@effect-tavern/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "bun check && bun test/data.ts && bun test/export.ts && bun test/serve.ts",
    "start": "bun src/main.ts",
    "names": "bun src/names.ts",
    "compile": "bun build --compile src/main.ts --asset ../client/dist --asset ../runtime/test/cards --outfile dist/tavern && rm -f .*.bun-build",
    "compile:android": "bun build --compile --target=bun-linux-arm64-android src/main.ts --asset ../client/dist --asset ../runtime/test/cards --outfile dist/tavern-android && rm -f .*.bun-build"
  },
  "dependencies": {
    "@effect-tavern/provider": "workspace:*",
    "@effect-tavern/runtime": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.46.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
