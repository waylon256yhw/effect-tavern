{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src/*.ts", "test/*.ts"]
}
